FROM node:22-alpine

WORKDIR /usr/src/app

# `npm ci` exige package-lock.json comitado — sem ele o build aborta.
COPY package*.json ./
RUN npm ci

COPY . .

# O container escreve `dist/` no bind mount. Rodando como root, o artefato aterrissa
# no host com dono root e o `npm run build` do host passa a falhar com EACCES —
# nem `rm -rf dist` resolve sem docker ou sudo. O usuário `node` da imagem é uid 1000.
RUN chown -R node:node /usr/src/app
USER node

EXPOSE 3333

CMD ["npm", "run", "start:dev"]
